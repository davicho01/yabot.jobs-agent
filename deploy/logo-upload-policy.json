{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UploadContentAddressedLogos",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::yabot.jobs-frontend/logos/*"
    },
    {
      "Sid": "NeverTouchLiveAliases",
      "Effect": "Deny",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::yabot.jobs-frontend/logos/c/*"
    }
  ]
}
